# docker compose environment for Ycash lightwalletd (copy to .env; .env is gitignored).
# Every variable is read by docker/entrypoint.sh or docker-compose.yml; unset means the default.

# --- the node (ycashd, run by you, anywhere this container can reach) ---------------------
# With YCASHD_RPC_HOST set the four values go to the server as --rpchost/--rpcport/--rpcuser/
# --rpcpassword. host.docker.internal is the Docker host (Desktop, and Linux via extra_hosts).
# Leave YCASHD_RPC_HOST empty to read a mounted ycash.conf instead (see docker-compose.yml).
YCASHD_RPC_HOST=host.docker.internal
YCASHD_RPC_PORT=8832            # mainnet 8832, testnet/regtest 18832, or whatever rpcport= you set
YCASHD_RPC_USER=
YCASHD_RPC_PASSWORD=

# --- the server --------------------------------------------------------------------------
LWD_YELLOWBACK=1                # 1: serve the Yellowback (YED) service when the node offers yed_* (the vault upgrade)
#LWD_YELLOWBACK_MAX_INFLIGHT=16 # yed_* node calls in flight at once (0: unbounded)
#LWD_TRUSTED_PROXY_CIDRS=       # space-separated networks whose x-real-ip/x-forwarded-for are believed
LWD_INSECURE=0                  # 1: --no-tls-very-insecure. Regtest and a TLS-terminating proxy only.
#LWD_TLS_CERT=/etc/lightwalletd/tls/cert.pem   # inside the container; mount ./docker/tls there
#LWD_TLS_KEY=/etc/lightwalletd/tls/cert.key
LWD_LOG_LEVEL=4                 # logrus 1-7 (4 info, 5 debug)
#LWD_EXTRA_ARGS=                # anything else, verbatim (e.g. --ping-very-insecure)

# --- the host side -----------------------------------------------------------------------
LWD_BIND_HOST=127.0.0.1         # 0.0.0.0 to publish beyond this machine (then use real TLS)
LWD_GRPC_PORT=9067              # host port for gRPC (clients connect here)
LWD_HTTP_PORT=9068              # host port for the HTTP status endpoint
#LWD_IMAGE=ycash/lightwalletd:local
#LWD_VERSION=docker             # baked into GetLightdInfo.version at build time
